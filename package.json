{
  "name": "new-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Zyad Yasser's portfolio monorepo: public site, admin app, reviews app, blog app, and shared packages",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:reviews": "turbo run dev --filter=reviews",
    "dev:blog": "turbo run dev --filter=blog",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "firebase:emulators": "firebase emulators:start --only storage",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "seed": "pnpm --filter @repo/db seed",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "firebase-tools": "^15.35.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7",
      "postcss-selector-parser@<6.1.5": "^6.1.5",
      "uuid@<11.1.1": "^11.1.1",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "vite": "^8.3.5",
      "immutable@<5.1.8": "^5.1.9"
    }
  }
}
