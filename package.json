    "sass": "^1.97.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.10.2",
