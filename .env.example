# Used by docker-compose.yml for local dev infra (docker compose reads .env from this
# directory automatically). Copy to .env and adjust if you want non-default credentials/ports.
# App-level env vars (DATABASE_URL, BETTER_AUTH_SECRET, etc.) live in each
# app/package's own .env.example instead - see apps/admin, packages/db, packages/auth.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=portfolio-uploads
