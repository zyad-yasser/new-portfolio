# The only .env in the repo that matters for local dev - packages/db, packages/auth, and
# packages/trpc all consume process.env directly (no .env files of their own), and their
# standalone CLI commands (drizzle-kit, the seed script) load this file explicitly via
# `dotenv -e ../../apps/admin/.env` (see packages/db/package.json).

# Local dev default, matches docker-compose.yml (`pnpm docker:up`):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Random secret used to sign session tokens - generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Base URL of this app (where Better Auth's API routes are mounted)
BETTER_AUTH_URL=http://localhost:3001

# Client-side copy of the same URL (must be NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

# Credentials for the seed script (pnpm --filter @repo/db seed / pnpm seed) that creates
# the single admin account. There is no public sign-up route. Idempotent - safe to rerun.
ADMIN_NAME=Zyad Yasser
ADMIN_EMAIL=
ADMIN_PASSWORD=
