{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "Private admin app for zyadyasser.net (admin.zyadyasser.net)",
  "scripts": {
    "dev": "next -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "type-check": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "seed": "pnpm --filter @repo/db seed",
    "clean": "rm -rf .next && rm -rf node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@repo/auth": "workspace:*",
    "@repo/trpc": "workspace:^",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@trpc/server": "^11.24.0",
    "better-auth": "^1.7.17",
    "lucide-react": "^0.469.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
