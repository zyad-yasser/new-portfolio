{
  "name": "web",
  "version": "3.0.0",
  "private": true,
  "description": "Zyad Yasser's portfolio site (zyadyasser.net), built with Next.js",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next && rm -rf node_modules",
    "favicon": "node scripts/generate-favicon-sharp.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@repo/email": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.469.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
