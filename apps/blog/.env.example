# Set both (run `pnpm firebase:emulators` first) to develop against the Storage emulator
# instead - FIREBASE_SERVICE_ACCOUNT isn't needed in that mode. Host has no protocol.
FIREBASE_STORAGE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=demo-portfolio
