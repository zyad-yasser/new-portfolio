DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
PUBLIC_BETTER_AUTH_SECRET=
PUBLIC_BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_PUBLIC_BETTER_AUTH_URL=http://localhost:3002
PUBLIC_TRUSTED_ORIGINS=https://reviews.zyadyasser.net,https://blog.zyadyasser.net
# PUBLIC_COOKIE_DOMAIN=.zyadyasser.net

# Identifies this app for rate-limit key namespacing (packages/trpc) — must be unique per app.
APP_NAME=reviews

# Upstash Redis (REST API) — shared across all four apps for rate limiting / session caching,
# each namespaces its own keys internally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot protection on sign-up. Can share the same site/secret as apps/blog.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
